# URL base pública do app (usada nos QR Codes). Em produção, o domínio real.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOMENTE servidor. Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: pedidos por IP a cada 10 min (padrão 5). Aumente só em testes.
# ORDER_RATE_LIMIT=5

# Hospedagem confiável à frente do app: "vercel" ou "cloudflare". Sem isso, cabeçalhos de IP são
# ignorados (cliente pode forjá-los) e o limite usa um balde único. Defina em produção.
# TRUSTED_PROXY=vercel
